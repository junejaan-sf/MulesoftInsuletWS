#%RAML 1.0 Trait

description: Adds sourceSystem and targetSystem parameters for tracking integration flow
headers:
  sourceSystem:
    type: string
    required: true
    example: "CRM"
    description: The system from which the request originates
  targetSystem:
    type: string
    required: true
    example: "ERP"
    description: The system to which the request is directed
