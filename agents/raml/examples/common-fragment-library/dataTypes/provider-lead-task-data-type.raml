#%RAML 1.0 DataType
type: object
description: Task object for provider lead follow-up
properties:
  recordType:
    type: string
    description: Task record type
    required: false
  subject:
    type: string
    description: Task subject
    required: false
  phone:
    type: string
    description: Contact phone number for task
    required: false
  email:
    type: string
    description: Contact email for task
    required: false
  activityDate:
    type: date-only
    description: Task activity date
    required: false
  status:
    type: string
    description: Task status
    required: false
  priority:
    type: string
    description: Task priority
    required: false
  description:
    type: string
    description: Task description
    required: false
  contactMethods:
    type: string
    description: Preferred contact methods
    required: false
  outreachAttempt:
    type: string
    description: Outreach attempt marker
    required: false
  category:
    type: string
    description: Task category
    required: false
  subCategory:
    type: string
    description: Task sub-category
    required: false