#%RAML 1.0 DataType
type: object
description: Request body for creating a provider lead
properties:
  firstName:
    type: string
    description: First name of the provider
    required: true
  lastName:
    type: string
    description: Last name of the provider
    required: true
  street:
    type: string
    description: Street address
    required: false
  city:
    type: string
    description: City
    required: false
  stateCode:
    type: string
    description: State code
    required: false
  postalCode:
    type: string
    description: Postal code
    required: false
  email:
    type: string
    description: Provider email
    required: false
  hcpType:
    type: string
    description: HCP type
    required: false
  degreeDescription:
    type: string
    description: Degree description
    required: false
  otherDegreeInfo:
    type: string
    description: Additional degree information
    required: false
  npi:
    type: string
    description: Provider NPI
    required: false
  licenseNumber:
    type: string
    description: Provider license number
    required: false
  phone:
    type: string
    description: Provider phone
    required: false
  inquiryDetails:
    type: string
    description: Inquiry details
    required: false
  drupalURL:
    type: string
    description: Source Drupal URL
    required: false
  leadSource:
    type: string
    description: Source of the lead
    required: false
  statusReason:
    type: string
    description: Status reason text
    required: false
  practiceName:
    type: string
    description: Practice name
    required: false
  cKey:
    type: string
    description: Campaign key
    required: false
  campaignName:
    type: string
    description: Campaign name
    required: false
  consents:
    type: array
    description: List of consent preferences
    required: false
    items: !include provider-lead-consent-data-type.raml
  task:
    description: Optional follow-up task payload
    required: false
    type: !include provider-lead-task-data-type.raml