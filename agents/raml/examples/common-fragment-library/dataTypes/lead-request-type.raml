#%RAML 1.0 DataType
type: object
description: Request body for creating a patient lead
properties:
  firstName:
    type: string
    description: First name of the patient
    required: true
  lastName:
    type: string
    description: Last name of the patient
    required: true
  caregiverFirstname:
    type: string
    description: First name of the caregiver
    required: false
  caregiverLastName:
    type: string
    description: Last name of the caregiver
    required: false
  email:
    type: string
    description: Email address of the patient
    required: false
  typeOfDiabetes:
    type: string
    description: Type of diabetes the patient has
    required: false
  preferredLanguage:
    type: string
    description: Preferred language for communication
    required: false
  patientDOB:
    type: date-only
    description: Date of birth of the patient (Format YYYY-MM-DD)
    required: false
  patientId:
    type: string
    description: Patient identifier from external system
    required: false
  relationshipToPatient:
    type: string
    description: Relationship of the caregiver to the patient
    required: false
  leadSource:
    type: string
    description: Source of the lead
    required: false
  company:
    type: string
    description: Company name
    required: false
  npi:
    type: string
    description: National Provider Identifier
    required: false
  cKey:
    type: string
    description: Customer token matching Campaign Key in Salesforce
    required: false
  externalSystemId:
    type: string
    description: Identifier from the external system of record
    required: false
  currentTherapy:
    type: string
    description: Current therapy the patient is undergoing
    required: false
  genderIdentity:
    type: string
    description: Gender identity of the patient
    required: false
  phone:
    type: string
    description: Phone number of the patient
    required: false
  mobilePhone:
    type: string
    description: Mobile phone number of the patient
    required: false
  fax:
    type: string
    description: Fax number
    required: false
  street:
    type: string
    description: Street address
    required: false
  city:
    type: string
    description: City
    required: false
  state:
    type: string
    description: State or province name
    required: false
  stateCode:
    type: string
    description: State code
    required: false
  postalCode:
    type: string
    description: Postal code
    required: false
  insuranceType:
    type: string
    description: Type of insurance
    required: false
  insuranceCompany:
    type: string
    description: Insurance company name
    required: false
  sensorCGM:
    type: string
    description: Sensor CGM information
    required: false
  pifProcess:
    type: string
    description: PIF process type
    required: false
  callMe:
    type: string
    description: Flag indicating if the patient wants to be called
    required: false
  drupalURL:
    type: string
    description: Drupal URL reference
    required: false
  referralOmnipodSource:
    type: string
    description: Referral Omnipod source
    required: false
  purposeName:
    type: string
    description: Purpose name for the lead
    required: false
  source:
    type: string
    description: Source of the lead
    required: false
  status:
    type: string
    description: Status of the lead
    required: false
  consents:
    type: array
    required: false
    items:
      type: object
      properties:
        purposeName:
          type: string
          description: The purpose or type of the consent.
          required: false
        source:
          type: string
          description: The capture source (e.g., web).
          required: false
        status:
          type: string
          description: The consent status (e.g., Opt-in, Opt-out).
          required: false
    description: Array of consent records to apply