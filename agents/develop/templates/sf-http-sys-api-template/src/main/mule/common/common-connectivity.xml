	<!-- =========================================================
	     REUSABLE SF EXECUTION FLOWS
	     All five flows follow the same pattern:
	       until-successful (retry on transient SFDC errors)
	         try
	           SF operation
	           FV Set Success = true, Error = null
	           error-handler
	             on-error-propagate (transient) → FV success=false
	             on-error-continue (non-transient) → FV success=false
	       check-for-raise-error-sub-flow
	       error-handler → on-error-propagate → LOG ERROR (EXCEPTION)

	     Callers set vars.targetApiParams / vars.queryPayload /
	     vars.upsertRequestDetails / vars.updateRequestDetails
	     before calling the appropriate flow via flow-ref.
	     ========================================================= -->

	<!-- =========================================================
	     SALESFORCE CREATE
	     Input:  vars.targetApiParams.sfObject (sObject API name)
	             payload (List of Map — field/value pairs)
	     Output: payload (List of SaveResult)
	     ========================================================= -->
	<flow name="execute-sf-create-flow" doc:id="77777777-bbbb-cccc-dddd-000000000022">
		<until-successful maxRetries="${retry.attempts}" doc:name="Retry" doc:id="88888888-bbbb-cccc-dddd-000000000023" millisBetweenRetries="${retry.interval}">
			<try doc:name="Try" doc:id="99999999-bbbb-cccc-dddd-000000000024">
				<salesforce:create
					type="#[vars.targetApiParams.sfObject]"
					doc:name="Execute SF Create"
					doc:id="aaaaaaaa-bbbb-cccc-dddd-000000000025"
					config-ref="salesforce_config" />
				<ee:transform doc:name="FV Set Success = true, Error = null" doc:id="bbbbbbbb-bbbb-cccc-dddd-000000000026">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="success"><![CDATA[true]]></ee:set-variable>
						<ee:set-variable variableName="errorDetails"><![CDATA[null]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<error-handler>
					<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="cccccccc-bbbb-cccc-dddd-000000000027" type="${sfdcTransientErrors}">
						<ee:transform doc:name="FV Set Success = false, Error Details" doc:id="dddddddd-bbbb-cccc-dddd-000000000028">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="success"><![CDATA[false]]></ee:set-variable>
								<ee:set-variable variableName="errorDetails"><![CDATA[%dw 2.0
output application/java
---
error]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</on-error-propagate>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="eeeeeeee-bbbb-cccc-dddd-000000000029">
						<ee:transform doc:name="FV Set Success = false, Error Details" doc:id="ffffffff-bbbb-cccc-dddd-000000000030">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="success"><![CDATA[false]]></ee:set-variable>
								<ee:set-variable variableName="errorDetails"><![CDATA[%dw 2.0
output application/java
---
error]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</on-error-continue>
				</error-handler>
			</try>
		</until-successful>
		<flow-ref doc:name="Refer to check-for-raise-error-sub-flow" doc:id="11111111-cccc-dddd-eeee-000000000031" name="check-for-raise-error-sub-flow" />
		<error-handler>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="22222222-cccc-dddd-eeee-000000000032">
				<module-logger:build-error-log-without-payload
					doc:name="LOG ERROR"
					doc:id="33333333-cccc-dddd-eeee-000000000033"
					config-ref="custom-logger-connector_config"
					message="Error executing SF create request"
					logLevel="INFO"
					tracepoint="EXCEPTION"
					sourceSystem="#[vars.requestContext.sourceSystem]"
					targetSystem="#[vars.requestContext.targetSystem]"
					errorType='#[((vars.errorDetails.errorType.namespace default "UNKNOWN") ++ ":" ++ (vars.errorDetails.errorType.identifier default "UNKNOWN"))]'
					errorDescription='#[vars.errorDetails.description default "Unhandled error"]'
					cause='#[vars.errorDetails.cause.message default ""]'
					errorCode="#[vars.errorDetails.cause.errorMessage.attributes.statusCode default 500]" />
			</on-error-propagate>
		</error-handler>
	</flow>

	<!-- =========================================================
	     SALESFORCE QUERY
	     Input:  vars.queryPayload.query (SOQL string)
	     Output: payload (Iterator of Map — query result rows)
	     ========================================================= -->
