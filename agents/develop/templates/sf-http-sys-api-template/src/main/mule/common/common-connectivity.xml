	<!-- =========================================================
	     SALESFORCE COMPOSITE REQUEST
	     Input:  payload (CompositeRequest object — allOrNone + compositeRequest[])
	             uses salesforce-composite_config (may be a different SF user/org)
	     Output: payload (CompositeResponse with compositeResponse[])
	     Remove this flow if composite operations are not required.
	     ========================================================= -->
	<flow name="execute-sf-composite-flow" doc:id="aaaaaaaa-eeee-ffff-aaaa-000000000070">
		<until-successful maxRetries="${retry.attempts}" doc:name="Retry" doc:id="bbbbbbbb-eeee-ffff-aaaa-000000000071" millisBetweenRetries="${retry.interval}">
			<try doc:name="Try" doc:id="cccccccc-eeee-ffff-aaaa-000000000072">
				<salesforce-composite:execute-composite-request
					doc:name="Execute Composite Request"
					doc:id="dddddddd-eeee-ffff-aaaa-000000000073"
					config-ref="salesforce-composite_config" />
				<ee:transform doc:name="FV Set Success = true, Error = null" doc:id="eeeeeeee-eeee-ffff-aaaa-000000000074">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="success"><![CDATA[true]]></ee:set-variable>
						<ee:set-variable variableName="errorDetails"><![CDATA[null]]></ee:set-variable>
