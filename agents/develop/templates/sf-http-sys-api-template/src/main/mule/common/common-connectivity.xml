				</ee:transform>
				<error-handler>
					<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="99999999-cccc-dddd-eeee-000000000039" type="${sfdcTransientErrors}">
						<ee:transform doc:name="FV Set Success = false, Error Details" doc:id="aaaaaaaa-cccc-dddd-eeee-000000000040">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="success"><![CDATA[false]]></ee:set-variable>
								<ee:set-variable variableName="errorDetails"><![CDATA[%dw 2.0
output application/java
---
error]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</on-error-propagate>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="bbbbbbbb-cccc-dddd-eeee-000000000041">
						<ee:transform doc:name="FV Set Success = false, Error Details" doc:id="cccccccc-cccc-dddd-eeee-000000000042">
							<ee:message />
							<ee:variables>
								<ee:set-variable variableName="success"><![CDATA[false]]></ee:set-variable>
								<ee:set-variable variableName="errorDetails"><![CDATA[%dw 2.0
output application/java
---
error]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</on-error-continue>
				</error-handler>
			</try>
		</until-successful>
		<flow-ref doc:name="Refer to check-for-raise-error-sub-flow" doc:id="dddddddd-cccc-dddd-eeee-000000000043" name="check-for-raise-error-sub-flow" />
		<error-handler>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="eeeeeeee-cccc-dddd-eeee-000000000044">
				<module-logger:build-error-log-without-payload
					doc:name="LOG ERROR"
					doc:id="ffffffff-cccc-dddd-eeee-000000000045"
					config-ref="custom-logger-connector_config"
					message="Error executing SF query request"
					logLevel="INFO"
					tracepoint="EXCEPTION"
					sourceSystem="#[vars.requestContext.sourceSystem]"
					targetSystem="#[vars.requestContext.targetSystem]"
					errorType='#[((vars.errorDetails.errorType.namespace default "UNKNOWN") ++ ":" ++ (vars.errorDetails.errorType.identifier default "UNKNOWN"))]'
					errorDescription='#[vars.errorDetails.description default "Unhandled error"]'
					cause='#[vars.errorDetails.cause.message default ""]'
					errorCode="#[vars.errorDetails.cause.errorMessage.attributes.statusCode default 500]" />
			</on-error-propagate>
		</error-handler>
	</flow>

