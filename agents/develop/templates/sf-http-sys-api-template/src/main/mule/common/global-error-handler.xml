<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:module-error-handler-plugin="http://www.mulesoft.org/schema/mule/module-error-handler-plugin"
	xmlns:module-logger="http://www.mulesoft.org/schema/mule/module-logger"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/module-error-handler-plugin http://www.mulesoft.org/schema/mule/module-error-handler-plugin/current/mule-module-error-handler-plugin.xsd
		http://www.mulesoft.org/schema/mule/module-logger http://www.mulesoft.org/schema/mule/module-logger/current/mule-module-logger.xsd">

	<!-- =========================================================
	     GLOBAL ERROR HANDLER
	     Single on-error-continue for HTTP synchronous pattern.
	     No NACK/ACK needed (contrast with MQ proc-api pattern).
	     Steps:
	       1. Map error to HTTP status via customErrors.dwl
	       2. Set httpStatus variable
	       3. LOG ERROR (INFO without-payload, tracepoint=EXCEPTION)
	       4. LOG ERROR (DEBUG encrypted-payload, tracepoint=EXCEPTION)
	     ========================================================= -->
	<error-handler name="global-error-handler" doc:id="dddddddd-aaaa-bbbb-cccc-000000000013">
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="eeeeeeee-aaaa-bbbb-cccc-000000000014">

			<!-- Map error type → { httpStatus, reason, message } via customErrors.dwl -->
			<module-error-handler-plugin:process-error
				doc:name="Process Error"
				doc:id="ffffffff-aaaa-bbbb-cccc-000000000015"
				error="#[vars.errorDetails default error]">
				<module-error-handler-plugin:custom-errors><![CDATA[#[${file::errors/customErrors.dwl}]]]></module-error-handler-plugin:custom-errors>
			</module-error-handler-plugin:process-error>

			<!-- Set httpStatus from processed error attributes -->
			<set-variable
				variableName="httpStatus"
				value="#[attributes.httpStatus]"
				doc:name="Set HTTP Status Code"
				doc:id="11111111-bbbb-cccc-dddd-000000000016" />

			<!-- INFO log — no payload, for general observability -->
			<module-logger:build-error-log-without-payload
				doc:name="Log Error"
				doc:id="22222222-bbbb-cccc-dddd-000000000017"
				config-ref="custom-logger-connector_config"
				message='#[output application/json --- (attributes.httpStatus default "500") ++ " " ++ (payload.error.reason default "Internal Server Error")]'
				tracepoint="EXCEPTION"
				sourceSystem="#[vars.requestContext.sourceSystem]"
				targetSystem="#[vars.requestContext.targetSystem]"
				errorType='#[output application/json --- ((vars.errorDetails.errorType.namespace default error.errorType.namespace default "UNKNOWN") ++ ":" ++ (vars.errorDetails.errorType.identifier default error.errorType.identifier default "UNKNOWN"))]'
				errorDescription='#[output application/json --- vars.errorDetails.message default payload.error.message default error.description default "Unhandled error"]'
				cause='#[output application/json --- vars.errorDetails.cause.message default error.cause.message default error.cause default ""]'
				errorCode='#[vars.httpStatus default "500"]' />

			<!-- DEBUG log — encrypted payload for triage -->
			<module-logger:build-error-log-with-encrypted-payload
				doc:name="Log Error"
				doc:id="33333333-bbbb-cccc-dddd-000000000018"
				config-ref="custom-logger-connector_config"
				message='#[output application/json --- ((attributes.httpStatus default "500") ++ " " ++ (payload.error.reason default "There is a server issue"))]'
				tracepoint="EXCEPTION"
				sourceSystem="#[vars.requestContext.sourceSystem]"
				targetSystem="#[vars.requestContext.targetSystem]"
				errorType='#[output application/json --- ((vars.errorDetails.errorType.namespace default error.errorType.namespace default "UNKNOWN") ++ ":" ++ (vars.errorDetails.errorType.identifier default error.errorType.identifier default "UNKNOWN"))]'
				errorDescription='#[output application/json --- vars.errorDetails.message default payload.error.message default error.description default "Unhandled error"]'
				cause='#[output application/json --- vars.errorDetails.cause.message default error.cause.message default error.cause default ""]'
				errorCode="#[(attributes.httpStatus default vars.httpStatus default 500)]">
				<module-logger:body><![CDATA[#[output application/json --- vars.requestContext.originalPayload default {}]]]></module-logger:body>
			</module-logger:build-error-log-with-encrypted-payload>

			<foreach doc:name="For Each" collection="#[namesOf(vars)]">
				<remove-variable doc:name="Removing All Variables" variableName="#[payload]"/>
			</foreach>

		</on-error-continue>
	</error-handler>

	<!-- =========================================================
	     CHECK FOR RAISE ERROR SUB-FLOW
	     Called after every SF execution flow.
	     Raises APP:CONNECTIVITY_FAILED when vars.success == false,
	     routing the error into the global handler above.
	     ========================================================= -->
	<sub-flow name="check-for-raise-error-sub-flow" doc:id="44444444-bbbb-cccc-dddd-000000000019">
		<choice doc:name="CHECK for Success == false" doc:id="55555555-bbbb-cccc-dddd-000000000020">
			<when expression="#[!vars.success default false]">
				<raise-error
					doc:name="RAISE APP:CONNECTIVITY_FAILED ERROR"
					doc:id="66666666-bbbb-cccc-dddd-000000000021"
					type="APP:CONNECTIVITY_FAILED"
					description='#[vars.errorDetails.description default error.detailedDescription default ""]' />
			</when>
		</choice>
	</sub-flow>

</mule>
