<?xml version="1.0" encoding="utf-8"?>
<!--
  log4j2.xml — Insulet standard logging configuration for a Salesforce HTTP sys-api.

  Three AsyncLogger categories required by the Insulet Custom Logger Connector:
    com.insulet.general       — INFO-level without-payload logs (build-log-without-payload,
                                build-error-log-without-payload operations)
    com.insulet.payload       — DEBUG-level encrypted/masked payload logs
                                (build-log-with-encrypted-payload, build-error-log-with-encrypted-payload)
    com.insulet.datadog       — INFO-level Datadog JSON socket appender

  PROD requirement: ALL three categories must be set to WARN in production.
  Leaving DEBUG in prod violates the Insulet logging standard.
-->
<Configuration status="INFO" name="cloudhub"
    packages="com.insulet.datadog,org.apache.logging.log4j">

    <Appenders>
        <!-- Rolling file appender — 10 MB per file, max 10 files -->
        <RollingFile name="file"
            fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}${project.artifactId}.log"
            filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}${project.artifactId}-%i.log">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Datadog log appender — JSON batched over TCP socket -->
        <DataDogLog4jAppender name="DATADOG"
            endpoint="${sys:DATADOG_HOST}"
            apiKey="${sys:DATADOG_API_KEY}"
            source="MuleSoft"
            host="${hostName}"
            service="${project.artifactId}"
            apiLayer="${sys:anypoint.platform.visualizer.layer}"
            environment="${sys:mule.env}"
            ddTags="integration:MuleSoft-To-DataDog"
            batchSize="500"
            maxBytesPerBatch="5242880"
            flushIntervalMs="5000"
            connectTimeoutMs="2000"
            readTimeoutMs="10000"
            retryEnabled="true"
            retryCount="3"
            enableCircuitBreaker="true"
            circuitBreakerFailures="5"
            circuitBreakerOpenMs="30000"
            compressPayloads="true">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n" />
        </DataDogLog4jAppender>
    </Appenders>

    <Loggers>
        <!-- Suppress noisy Mule/HTTP internal loggers -->
        <AsyncLogger name="org.mule.service.http" level="WARN"/>
        <AsyncLogger name="org.mule.extension.http" level="WARN"/>

        <!-- Mule built-in logger (not used in this project — prefer module-logger) -->
        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="INFO"/>

        <!--
            Insulet Custom Logger categories.
            DEV/QA/UAT:
              com.insulet.general     INFO  — without-payload info/error logs
              com.insulet.payload     DEBUG — encrypted payload logs for triage
              com.insulet.datadog     INFO  — Datadog structured JSON

            PROD: ALL must be WARN. Change all three levels to WARN before prod deployment.
        -->
        <AsyncLogger name="com.insulet.general"  level="INFO" />
        <AsyncLogger name="com.insulet.payload"  level="DEBUG" />
        <AsyncLogger name="com.insulet.datadog"  level="INFO" />

        <AsyncRoot level="INFO">
            <AppenderRef ref="file"/>
            <AppenderRef ref="DATADOG"/>
        </AsyncRoot>
    </Loggers>

</Configuration>
