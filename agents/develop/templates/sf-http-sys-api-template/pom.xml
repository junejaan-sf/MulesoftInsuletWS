<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>260ebaee-d8f1-4739-bb12-b8db2f1568ca</groupId>
		<artifactId>mule-common-pom</artifactId>
		<version>1.0.9</version>
	</parent>

	<groupId>e0bc8c96-9dbd-48bc-915e-3e29577af6b3</groupId>
	<artifactId>sf-http-sys-api-template</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>mule-application</packaging>
	<name>sf-http-sys-api-template</name>
	<description>Template project for a Salesforce system API exposing HTTP synchronous REST endpoints. Covers standard Salesforce CRUD (create/query/upsert/update) and composite connector patterns with ObjectStore RecordType caching.</description>

	<properties>
		<!-- API Details -->
		<api.raml.version>1.0.0</api.raml.version>
		<!-- Application Details -->
		<app.name>${project.name}</app.name>
		<app.version>v1</app.version>
		<tags>sys</tags>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<!-- exclude binary files such as keystores from Maven filtering -->
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
				<filtering>true</filtering>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<classifier>mule-application</classifier>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- RAML Spec from Anypoint Exchange -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sf-http-sys-api-template-spec</artifactId>
			<version>${api.raml.version}</version>
			<classifier>raml</classifier>
			<type>zip</type>
		</dependency>

		<!-- Salesforce Standard Connector — create, query, upsert, update, get-server-timestamp -->
		<dependency>
			<groupId>com.mulesoft.connectors</groupId>
			<artifactId>mule-salesforce-connector</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Salesforce Composite Connector — execute-composite-request -->
		<dependency>
			<groupId>com.mulesoft.connectors</groupId>
			<artifactId>mule-salesforce-composite-connector</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- ObjectStore Connector — RecordType ID caching -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-objectstore-connector</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Validation Module — input validation -->
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-validation-module</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Datadog Log Appender -->
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>log4j-datadog-appender</artifactId>
			<version>1.0.1</version>
		</dependency>

		<!-- Test assertions -->
		<dependency>
			<groupId>org.mule.weave</groupId>
			<artifactId>assertions</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
