<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<!--
		Common MUnit Test Suite — ping and health-check endpoints.
		Replace "tmpl" prefix with the actual 4-6 character API prefix (e.g., "acct", "lead").
	-->
	<munit:config name="common-test-suite" />

	<!--
		TEST 1: Ping Success
		GET /ping returns liveness response with status "alive".
		Called directly on the APIKit-generated ping flow.
		vars.requestContext is set manually — http-proc-api-template-main is NOT called.
		Dynamic fields (timestamp, correlationId) are asserted structurally, not by value.
	-->
	<munit:test name="tmpl-ping-success"
		description="GET /ping - Returns alive liveness response"
		tags="SUCCESS">

		<munit:execution>
			<munit:set-event doc:name="Set Ping Request">
				<munit:payload value="#[output application/json --- {}]" mediaType="application/json" />
				<munit:attributes value="#[{ uriParams: {} }]" />
				<munit:variables>
					<munit:variable key="requestContext" value="#[output application/java --- {
						headers: { 'sourceSystem': '{source-system}', 'targetSystem': '{target-system}' },
						queryParams: {},
						uriParams: {},
						originalPayload: {},
						requestPath: '/api/v1/ping',
						sourceSystem: '{source-system}',
						targetSystem: '{target-system}'
					}]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to GET ping endpoint"
				name="get:\ping:http-proc-api-template-spec-config" />
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that expression="#[payload.status]"
				is="#[MunitTools::equalTo('alive')]"
				message="Expected status alive"
				doc:name="Assert Status Alive" />

			<munit-tools:assert-that expression="#[payload.apiName]"
				is="#[MunitTools::notNullValue()]"
				message="Expected apiName to be present"
				doc:name="Assert API Name Present" />

			<munit-tools:assert-that expression="#[payload.version]"
				is="#[MunitTools::notNullValue()]"
				message="Expected version to be present"
				doc:name="Assert Version Present" />
		</munit:validation>
	</munit:test>

	<!--
		TEST 2: Health Check All Up
		GET /health-check — all 3 downstream SAPIs return 200 with { status: "up" }.
		http:request is mocked (no-target flow-refs in health-check-ready.xml).
		Each route normalises the response to { apiName, status: "up" }.
		Readiness DWL sets overall status to "ready".
		Update sizeOf assertion if you add or remove downstream SAPIs from health-check-ready.xml.
	-->
	<munit:test name="tmpl-health-check-all-up-success"
		description="GET /health-check - All downstream SAPIs return up, overall status is ready"
		tags="SUCCESS">

		<munit:behavior>
			<munit-tools:mock-when processor="http:request" doc:name="Mock HTTP Request to Downstream SAPI">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="doc:name" whereValue="HTTP Request to Downstream SAPI" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[output application/json --- readUrl('classpath://testdata/common/technical-outbound/health-check-sapi-up-response.json')]" />
					<munit-tools:attributes value="#[{statusCode: 200}]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<munit:set-event doc:name="Set Health Check Request">
				<munit:payload value="#[output application/json --- {}]" mediaType="application/json" />
				<munit:attributes value="#[{ uriParams: {} }]" />
				<munit:variables>
					<munit:variable key="requestContext" value="#[output application/java --- {
						headers: { 'sourceSystem': '{source-system}', 'targetSystem': '{target-system}' },
						queryParams: {},
						uriParams: {},
						originalPayload: {},
						requestPath: '/api/v1/health-check',
						sourceSystem: '{source-system}',
						targetSystem: '{target-system}'
					}]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to GET health-check endpoint"
				name="get:\health-check:http-proc-api-template-spec-config" />
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that expression="#[payload.status]"
				is="#[MunitTools::equalTo('ready')]"
				message="Expected status ready"
				doc:name="Assert Status Ready" />

			<!-- Update this count to match the number of scatter-gather routes in health-check-ready.xml -->
			<munit-tools:assert-that expression="#[sizeOf(payload.dependencies)]"
				is="#[MunitTools::equalTo(3)]"
				message="Expected 3 dependencies in health-check response"
				doc:name="Assert 3 Dependencies" />

			<munit-tools:assert-that expression="#[payload.apiName]"
				is="#[MunitTools::notNullValue()]"
				message="Expected apiName to be present"
				doc:name="Assert API Name Present" />
		</munit:validation>
	</munit:test>

	<!--
		TEST 3: Health Check All Down
		GET /health-check — all downstream SAPIs are unavailable.
		common-http-request-flow is mocked (via flow-ref) to throw APP:CONNECTIVITY_FAILED,
		avoiding retry delays from until-successful (retry.attempts × retry.interval per route).
		Each scatter-gather route has its own try/on-error-continue that normalises to
		{ apiName, status: "down" }. Readiness DWL sets overall status to "not ready".
	-->
	<munit:test name="tmpl-health-check-all-down"
		description="GET /health-check - All downstream SAPIs unavailable, status is not ready"
		tags="ERROR">

		<munit:behavior>
			<munit-tools:mock-when processor="mule:flow-ref" doc:name="Mock Common HTTP Request Flow Error">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute attributeName="name" whereValue="common-http-request-flow" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:error typeId="APP:CONNECTIVITY_FAILED" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<munit:set-event doc:name="Set Health Check Request">
				<munit:payload value="#[output application/json --- {}]" mediaType="application/json" />
				<munit:attributes value="#[{ uriParams: {} }]" />
				<munit:variables>
					<munit:variable key="requestContext" value="#[output application/java --- {
						headers: { 'sourceSystem': '{source-system}', 'targetSystem': '{target-system}' },
						queryParams: {},
						uriParams: {},
						originalPayload: {},
						requestPath: '/api/v1/health-check',
						sourceSystem: '{source-system}',
						targetSystem: '{target-system}'
					}]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to GET health-check endpoint"
				name="get:\health-check:http-proc-api-template-spec-config" />
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that expression="#[payload.status]"
				is="#[MunitTools::equalTo('not ready')]"
				message="Expected status not ready"
				doc:name="Assert Status Not Ready" />

			<munit-tools:assert-that expression="#[sizeOf(payload.dependencies)]"
				is="#[MunitTools::equalTo(3)]"
				message="Expected 3 dependencies in health-check response"
				doc:name="Assert 3 Dependencies" />
		</munit:validation>
	</munit:test>

</mule>
