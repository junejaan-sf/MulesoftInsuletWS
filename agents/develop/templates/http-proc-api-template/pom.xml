<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>260ebaee-d8f1-4739-bb12-b8db2f1568ca</groupId>
		<artifactId>mule-common-pom</artifactId>
		<version>1.0.9</version>
	</parent>

	<groupId>e0bc8c96-9dbd-48bc-915e-3e29577af6b3</groupId>
	<artifactId>http-proc-api-template</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>mule-application</packaging>
	<name>http-proc-api-template</name>
	<description>Sync HTTP Process API Template — Orchestrates a primary downstream SAPI call followed by optional parallel operations via scatter-gather. Replace all {placeholder} tokens before use.</description>

	<properties>
		<!-- Replace api.raml.version with the actual published spec version -->
		<api.raml.version>1.0.0</api.raml.version>
		<app.name>${project.name}</app.name>
		<app.version>v1</app.version>
		<tags>proc</tags>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
				<filtering>true</filtering>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<extensions>true</extensions>
				<configuration>
					<classifier>mule-application</classifier>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- Test assertions (version managed by parent BOM) -->
		<dependency>
			<groupId>org.mule.weave</groupId>
			<artifactId>assertions</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Standard Mule modules (versions managed by parent BOM) -->
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-validation-module</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-json-module</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!--
			RAML spec from Anypoint Exchange.
			Replace "http-proc-api-template-spec" with the actual spec artifact ID
			once the RAML is published to Exchange.
		-->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>http-proc-api-template-spec</artifactId>
			<version>${api.raml.version}</version>
			<classifier>raml</classifier>
			<type>zip</type>
		</dependency>

		<!-- Datadog log appender -->
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>log4j-datadog-appender</artifactId>
			<version>1.0.1</version>
		</dependency>
	</dependencies>
</project>
