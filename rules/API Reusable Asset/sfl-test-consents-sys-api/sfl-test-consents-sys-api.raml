#%RAML 1.0
title: SFL Test Consents System API
description: System API to retrieve and update consents from Salesforce ContactPointTypeConsent.
version: v1
mediaType: application/json
baseUri: https://api.example.com/sfl-test-consents-sys-api/api/{version}

uses:
  CommonLib: exchange_modules/e0bc8c96-9dbd-48bc-915e-3e29577af6b3/common-fragment-library/1.0.16/common-fragment-library.raml

securedBy:
  - CommonLib.client-id-scheme

types:
  ConsentGetResponse: !include dataTypes/ConsentGetResponse.raml
  ConsentUpdateRequest: !include dataTypes/ConsentUpdateRequest.raml
  ConsentUpdateResponse: !include dataTypes/ConsentUpdateResponse.raml

/ping:
  get:
  is:
    - CommonLib.common-error-handler
    - CommonLib.common-headers
  type:
    CommonLib.liveliness-probe:

/health-check:
  get:
  is:
    - CommonLib.common-error-handler
    - CommonLib.common-headers
  type:
    CommonLib.readiness-probe:

/consents:
  displayName: Consents
  get:
    queryParameters:
      partyId:
        type: string
        required: true
        description: The party identifier to retrieve consents for.
      consentNames:
        type: string
        required: true
        description: Comma-separated consent names to query (e.g., Marketing Email,Transactional SMS).
  is:
    - CommonLib.common-error-handler
    - CommonLib.common-headers
    - CommonLib.system-headers
  type:
    CommonLib.generic:
      getDescription: Retrieve a list of consents from Salesforce for a given partyId and comma-separated list of consent names. Executes a SOQL query against the ContactPointTypeConsent object.
      getResponseExample: !include examples/ConsentsGetResponseExample.raml
      getResponseType: ConsentGetResponse

  /{id}:
    displayName: Consent by ID
    put:
      description: Update a specific consent record in Salesforce by its ID. Accepts optional source and status fields. Uses the Salesforce Connector Update Operation on ContactPointTypeConsent.
      body:
        application/json:
          type: ConsentUpdateRequest
          example: !include examples/ConsentUpdateRequestExample.raml
      responses:
        201:
          body:
            application/json:
              type: ConsentUpdateResponse
              example: !include examples/ConsentUpdateResponseExample.raml
    is:
      - CommonLib.common-error-handler
      - CommonLib.common-headers
      - CommonLib.system-headers
